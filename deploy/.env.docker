# ─────────────────────────────────────────────────────────────────────────────
# job-ability-graph 全栈容器化部署环境变量模板
# 用法：在 deploy/ 目录下执行  copy .env.docker .env
#       然后   docker compose up -d --build
# 所有变量都有安全默认值；未复制 .env 也可以直接启动。
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j ────────────────────────────────────────────────────────────────
# 官方镜像 tag。项目在 Neo4j 2026 上验证过；若目标机拉不到该 tag，
# 改用较新的 5.x（如 5.26.0），所用 Cypher 兼容 v5。
NEO4J_VERSION=2026.05.0
NEO4J_PASSWORD=jobgraph_neo4j_2026
NEO4J_DATABASE=neo4j
NEO4J_MAX_PATH_DEPTH=3
NEO4J_RETRIEVAL_LIMIT=20
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=768M
NEO4J_HEAP_MAX=1536M
NEO4J_PAGECACHE=1G

# ── Ollama（容器内自带，CPU 可跑 qwen2.5:7b，偏慢；GPU 见 docker-compose.gpu.yml）──
OLLAMA_VERSION=latest
LLM_BACKEND=ollama
# LLM_MODEL 必须与 ollama-pull 拉取的模型一致
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=300
LLM_MATCH_TIMEOUT_SECONDS=45
LLM_PROFILE_TIMEOUT_SECONDS=90
LLM_LEARNING_TIMEOUT_SECONDS=180
LLM_MAX_INPUT_CHARS=12000

# ── 语义嵌入召回（容器默认关闭；开启需要 GPU + 微调模型，见 README）──
EMBEDDING_BACKEND=off

# ── 数据 / 存储 ──────────────────────────────────────────────────────────
DB_BACKEND=sqlite
DB_PATH=/app/data/app.db
DATA_GOVERNANCE_ROOT=/app/data
JWT_SECRET_KEY=job-ability-graph-secret-key-2026-challenge-cup
# 首次启动自动注册的快照 id（图谱增量更新写入哪个快照）
TREND_UPDATE_GRAPH_SNAPSHOT=kg_prebuilt_v2

# ── OCR（容器镜像未内置 PaddleOCR；默认 cpu + 仅当需要解析上传图片/PDF）──
OCR_DEFAULT_LANG=ch
OCR_DEVICE=cpu
OCR_MAX_UPLOAD_MB=20

# ── 端口（宿主机映射；若本机已在跑便携版 Neo4j / 后端，先停掉或改端口）──
BACKEND_PORT=8002
WEB_PORT=8080
