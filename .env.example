# ============================================
# Job Ability Graph System - 环境配置
# ============================================

# 数据库配置 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=jd_matching_system

# 应用配置
APP_NAME=Job Ability Graph System
APP_VERSION=2.0.0
DEBUG=true

# API配置
API_PREFIX=/api

# LLM配置 (可选，默认关闭)
USE_LLM=false
