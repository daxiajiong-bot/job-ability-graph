# Default keeps all intelligence adapters in explicit mock mode.
GRAPH_BACKEND=mock

# Set GRAPH_BACKEND=neo4j to persist the knowledge graph in Neo4j.
# These defaults match docker-compose.neo4j.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobgraph_neo4j_2026
NEO4J_DATABASE=neo4j
NEO4J_MAX_PATH_DEPTH=3
NEO4J_RETRIEVAL_LIMIT=20

# Docker Compose settings for local Neo4j.
NEO4J_VERSION=2026.05.0
NEO4J_CONTAINER_NAME=job-ability-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=768M
NEO4J_HEAP_MAX=1536M
NEO4J_PAGECACHE=1G
NEO4J_TX_LOG_RETENTION=2 files

# OCR settings.
OCR_DEFAULT_LANG=ch
OCR_DEVICE=cpu
OCR_MAX_UPLOAD_MB=20
