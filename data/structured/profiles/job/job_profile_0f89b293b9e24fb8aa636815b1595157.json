  "extraction": {
    "evidence": [
      {
        "field": "responsibilities",
        "id": "ev_001",
        "text": "负责公司微信公众号、小红书、抖音、视频号等全平台新媒体账号的日常运营维护，制定阶段性运营计划，保障账号稳定更新，提升账号活跃度、粉丝量与用户粘性。"
      },
      {
        "field": "responsibilities",
        "id": "ev_002",
        "text": "独立完成文案撰写、图文排版、短视频脚本创作，结合行业热点、产品卖点输出原创内容，打造优质内容矩阵，提升品牌曝光度与影响力。"
      },
      {
        "field": "responsibilities",
        "id": "ev_003",
        "text": "跟踪新媒体平台运营数据，包括阅读量、点赞、转发、涨粉、转化等数据，定期做好数据复盘，分析内容优劣，优化运营策略，提升内容传播效果。"
      },
      {
        "field": "responsibilities",
        "id": "ev_004",
        "text": "策划线上营销活动、话题互动、粉丝福利等运营活动，联动用户、合作渠道完成活动落地，实现引流、涨粉、产品种草及销售转化目标。"
      },
      {
        "field": "responsibilities",
        "id": "ev_005",
        "text": "收集整理行业竞品动态、平台热点趋势，结合公司业务特性迭代内容风格与运营模式，配合市场部完成品牌推广、产品宣传相关工作。"
      },
      {
        "field": "responsibilities",
        "id": "ev_006",
        "text": "负责用户评论、私信日常维护，搭建良好的用户互动氛围，沉淀精准用户群体，提升用户口碑。"
      },
      {
        "field": "requirements",
        "id": "ev_007",
        "text": "大专及以上学历，新闻学、汉语言文学、新媒体、广告学、市场营销等相关专业优先，1-2年新媒体运营相关工作/实习经验。"
      },
      {
        "field": "requirements",
        "id": "ev_008",
        "text": "熟悉小红书、抖音、公众号、视频号等主流新媒体平台规则、流量机制，擅长热点捕捉和内容创新，具备独立内容创作能力。"
      },
      {
        "field": "requirements",
        "id": "ev_009",
        "text": "文案功底扎实，擅长图文撰写、短视频脚本编辑，熟练使用秀米、135编辑器、剪映等运营工具，基础审美良好，排版整洁美观。"
      },
      {
        "field": "requirements",
        "id": "ev_010",
        "text": "具备基础数据分析能力，能够通过后台数据复盘优化内容与运营策略，有成功账号涨粉、活动转化案例者优先。"
      },
      {
        "field": "requirements",
        "id": "ev_011",
        "text": "思维活跃、责任心强、执行力高，具备良好的沟通能力和团队协作意识，抗压能力强，能够适配互联网快节奏工作模式。"
      },
      {
        "field": "requirements",
        "id": "ev_012",
        "text": "有品牌新媒体运营、本地生活、电商内容运营经验者优先。"
      }
    ],
